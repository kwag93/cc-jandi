# Jandi MCP Server Configuration

# ==============================
# Incoming Webhook (채널 메시지)
# ==============================

# Default token (required)
JANDI_TOKEN=your_default_token_here

# Named tokens for different environments
JANDI_TOKEN_DEV=your_dev_token_here
JANDI_TOKEN_PROD=your_prod_token_here
JANDI_TOKEN_TEAM1=your_team1_token_here

# Custom webhook URLs (optional)
# If not provided, will use default Jandi webhook URL
JANDI_URL_DEV=https://script.google.com/macros/s/your_gas_script_id/exec
JANDI_URL_PROD=https://script.google.com/macros/s/your_gas_script_id/exec

# ==============================
# Team Incoming Webhook (개인 메시지)
# ==============================
# Each team token requires both TEAM_ID and TEAM_TOKEN with matching alias

JANDI_TEAM_ID_SALES=your_team_id_here
JANDI_TEAM_TOKEN_SALES=your_team_token_here
# JANDI_TEAM_URL_SALES=https://custom-url  # Optional custom URL

# JANDI_TEAM_ID_SUPPORT=your_team_id_here
# JANDI_TEAM_TOKEN_SUPPORT=your_team_token_here

# ==============================
# Outgoing Webhook (검증 토큰)
# ==============================
# Verification tokens for validating incoming outgoing webhook requests

# JANDI_OUTGOING_TOKEN_DEPLOY=your_outgoing_verification_token
# JANDI_OUTGOING_TOKEN_BOT=your_bot_verification_token

# ==============================
# Token format
# ==============================
# Example token format: abcdef0123456789abcdef0123456789
# Get your tokens from Jandi Connect settings
