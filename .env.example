# cc-jandi 환경 변수
#
# Claude Code 플러그인으로 설치했다면 /plugin 화면에서 토큰을 입력하면 되고,
# 이 파일은 필요하지 않습니다. MCP 서버를 직접 실행할 때만 쓰세요.

# ==============================
# Incoming Webhook (채널 메시지)
# ==============================
#
# 토큰은 잔디 커넥트가 발급한 웹훅 주소에서 '/connect-api/webhook/' 뒤에 오는
# 전체 경로입니다. 두 세그먼트를 모두 포함해야 합니다.
#
#   https://wh.jandi.com/connect-api/webhook/12345678/abcdef0123456789abcdef0123456789
#                                            └──────────── 여기부터 끝까지 ────────────┘
#
# 뒷부분만 넣으면 잔디가 403으로 거절합니다.

JANDI_TOKEN=00000000/0000000000000000000000000000000

# 채널별로 별칭을 붙여 여러 개를 둘 수 있습니다. 도구에서 tokenAlias로 고릅니다.
# JANDI_TOKEN_DEV=
# JANDI_TOKEN_PROD=

# 커스텀 엔드포인트로 우회할 때만 사용합니다 (별칭이 일치해야 적용됩니다).
# JANDI_URL_DEV=

# ==============================
# Team Incoming Webhook (개인 메시지)
# ==============================
#
# 이메일로 지정한 사람에게 개인 메시지를 보냅니다.
# 유료 팀 전용이며 팀 ID와 토큰을 토스랩(support@tosslab.com)이 발급합니다.
# 별칭이 같아야 한 쌍으로 인식됩니다.

# JANDI_TEAM_ID_SALES=
# JANDI_TEAM_TOKEN_SALES=
# JANDI_TEAM_URL_SALES=

# ==============================
# Outgoing Webhook (검증 토큰)
# ==============================
#
# 잔디가 보내온 요청이 진짜인지 확인할 때 쓰는 토큰입니다.
# 핸들러 서버를 직접 개발할 때만 필요합니다.

# JANDI_OUTGOING_TOKEN_DEPLOY=
